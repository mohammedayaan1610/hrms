# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<dbname>?retryWrites=true&w=majority

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_32_character_nextauth_secret_here

# Initial Admin Setup Configuration (used by scripts/create-admin.mjs)
ADMIN_EMAIL=admin@pulsehrms.com
ADMIN_PASSWORD=your_secure_admin_password_min_12_chars
ADMIN_EMPLOYEE_ID=HRMS-ADMIN-001
